{
  "name": "counter_program",
  "version": "0.1.0",
  "docs": ["A simple counter program for demonstration."],
  "metadata": {
    "address": "Coun1erxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  },
  "accounts": [
    {
      "name": "Counter",
      "discriminator": [255, 176, 4, 245, 188, 253, 124, 25],
      "docs": ["Stores a count value with associated metadata."],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "count",
            "type": "u64",
            "docs": ["The current count value."]
          },
          {
            "name": "authority",
            "type": "publicKey",
            "docs": ["The authority that can modify the counter."]
          },
          {
            "name": "bump",
            "type": "u8",
            "docs": ["PDA bump seed."]
          },
          {
            "name": "lastUpdated",
            "type": "i64",
            "docs": ["Unix timestamp of last update."]
          }
        ]
      }
    },
    {
      "name": "Config",
      "discriminator": [155, 12, 170, 224, 30, 250, 204, 95],
      "docs": ["Program configuration."],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "admin",
            "type": "publicKey",
            "docs": ["Admin authority."]
          },
          {
            "name": "maxCount",
            "type": "u64",
            "docs": ["Maximum allowed count value."]
          },
          {
            "name": "paused",
            "type": "bool",
            "docs": ["Whether the program is paused."]
          },
          {
            "name": "allowedMints",
            "type": {
              "kind": "vec",
              "value": "publicKey"
            },
            "docs": ["List of allowed mint addresses."]
          }
        ]
      }
    }
  ],
  "instructions": [
    {
      "name": "initialize",
      "discriminator": [175, 175, 109, 31, 13, 152, 155, 237],
      "docs": ["Initialize a new counter."],
      "accounts": [
        {
          "name": "counter",
          "isMut": true,
          "isSigner": false,
          "docs": ["The counter account to initialize."]
        },
        {
          "name": "authority",
          "isMut": true,
          "isSigner": true,
          "docs": ["The authority who will own the counter."]
        },
        {
          "name": "systemProgram",
          "isMut": false,
          "isSigner": false,
          "docs": ["System program."]
        }
      ],
      "args": [
        {
          "name": "initialValue",
          "type": "u64",
          "docs": ["Initial count value."]
        }
      ]
    },
    {
      "name": "increment",
      "discriminator": [11, 18, 104, 9, 104, 174, 59, 33],
      "docs": ["Increment the counter by a specified amount."],
      "accounts": [
        {
          "name": "counter",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "authority",
          "isMut": false,
          "isSigner": true
        }
      ],
      "args": [
        {
          "name": "amount",
          "type": "u64"
        }
      ]
    },
    {
      "name": "decrement",
      "discriminator": [106, 227, 168, 59, 248, 27, 150, 101],
      "docs": ["Decrement the counter."],
      "accounts": [
        {
          "name": "counter",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "authority",
          "isMut": false,
          "isSigner": true
        }
      ],
      "args": [
        {
          "name": "amount",
          "type": "u64"
        }
      ]
    },
    {
      "name": "reset",
      "discriminator": [229, 29, 203, 151, 93, 59, 149, 107],
      "docs": ["Reset the counter to zero."],
      "accounts": [
        {
          "name": "counter",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "authority",
          "isMut": false,
          "isSigner": true
        }
      ],
      "args": []
    }
  ],
  "types": [
    {
      "name": "CounterState",
      "docs": ["Enum representing counter states."],
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "Active" },
          { "name": "Paused" },
          { "name": "Frozen" }
        ]
      }
    }
  ],
  "events": [
    {
      "name": "CounterUpdated",
      "discriminator": [128, 45, 67, 89, 12, 34, 56, 78],
      "fields": [
        { "name": "counter", "type": "publicKey" },
        { "name": "previousValue", "type": "u64" },
        { "name": "newValue", "type": "u64" },
        { "name": "timestamp", "type": "i64" }
      ]
    }
  ],
  "errors": [
    {
      "code": 6000,
      "name": "CounterOverflow",
      "msg": "Counter would overflow maximum value"
    },
    {
      "code": 6001,
      "name": "CounterUnderflow",
      "msg": "Counter would underflow below zero"
    },
    {
      "code": 6002,
      "name": "Unauthorized",
      "msg": "Unauthorized access"
    },
    {
      "code": 6003,
      "name": "ProgramPaused",
      "msg": "Program is paused"
    }
  ]
}
